# Grouper Web Services Configuration
# Copy this file to .env and fill in your actual credentials

# Base URL for your Grouper installation
GROUPER_BASE_URL=https://grouper.institution.edu

# Authentication credentials
GROUPER_USERNAME=your_username
GROUPER_PASSWORD=your_password

# Optional: set to true to log full request/response payloads to stderr.
# Leave unset in normal use - the output includes member lists and subject data.
GROUPER_DEBUG=false
